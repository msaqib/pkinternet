{"name":"tid","value":"G-MTXV1E8CFT"},{"name":"gtm","value":"45je68e1v9194545357za200zd9194545357"},{"name":"_p","value":"1788361112988"},{"name":"gcd","value":"13l3l3l3l1l1"},{"name":"npa","value":"0"},{"name":"dma","value":"0"},{"name":"cid","value":"1706164018.1788361117"},{"name":"frm","value":"0"},{"name":"ngs","value":"1"},{"name":"pscdl","value":"noapi"},{"name":"rcb","value":"5"},{"name":"sr","value":"800x600"},{"name":"uaa","value":"arm"},{"name":"uab","value":"64"},{"name":"uafvl","value":"Not%3FA_Brand;24.0.0.0|Chromium;152.0.7977.54"},{"name":"uam","value":""},{"name":"uamb","value":"0"},{"name":"uap","value":"macOS"},{"name":"uapv","value":"14.4.1"},{"name":"uaw","value":"0"},{"name":"ul","value":"en-us"},{"name":"_s","value":"1"},{"name":"tag_exp","value":"115616986~115938465~115938468~118897920~118897930~119367802~119367810~120385422"},{"name":"sid","value":"1788361117"},{"name":"sct","value":"1"},{"name":"seg","value":"0"},{"name":"dl","value":"https://ibcc.edu.pk/"},{"name":"dt","value":"Inter Boards Coordination Commission (IBCC) – The Inter Boards Coordination Commission (IBCC), reconstituted in April 2023 through the IBCC Act (Act XIII of 2023), is a national body under the auspices of the Ministry of Federal Education and Professional Training (MoFE&PT) dedicated to enhancing secondary and higher secondary education standards across Pakistan. Established in 1972 as the Inter Boards Committee of Chairmen, the IBCC serves as a vital platform for the heads of examination boards across the country. It collaborates with both local and international institutions to set unified policies and standards in academic evaluation, examination, and assessment."},{"name":"en","value":"page_view"},{"name":"_fv","value":"1"},{"name":"_nsi","value":"1"},{"name":"_ss","value":"1"},{"name":"_ee","value":"1"},{"name":"tfd","value":"6075"}],"headersSize":-1,"bodySize":0,"cookies":[],"headers":[{"name":"sec-ch-ua-platform","value":"\"macOS\""},{"name":"Referer","value"