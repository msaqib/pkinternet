   "source": [
    "## Section 1:  Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 58,
   "id": "c864cfb4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Trace rows: 188,814  |  PK=75,517  CDN=75,576  Abroad=37,721\n",
      "Ping rows:  270,195   |  PK=73,459  CDN=137,037  Abroad=59,699\n",
      "Probes: ['cybernet.1016036', 'cybernet.1016143', 'cybernet.1016154', 'fasttel.1014872', 'nayatel.60223', 'nayatel.65892', 'nova.1015679', 'orbit.64535', 'ptcl.1016126', 'ptcl.1016393', 'ptcl.7764', 'tes.64078', 'tes.64722', 'transworld.62224', 'zcom.7613']\n",
      "PK sites: 40  CDN sites: 40  Abroad sites: 20\n"
     ]
