def parse_path(path_str):
    if pd.isna(path_str) or not str(path_str).strip():
        return []
    try:
        return [int(x.strip()) for x in str(path_str).split(">")]
    except Exception:
        return []

def can_reach(asn, target, visited=None, depth=0):
    """
    Can `asn` reach `target` through its known peers/upstreams?
    Checks up to 3 levels deep.
    """
    if depth > 3:
        return False
    if visited is None:
        visited = set()
    if asn in visited:
        return False
    visited.add(asn)

    peers = PEERS.get(asn, set())
    if target in peers:
        return True
    # check one level deeper
    for peer in peers:
        if peer not in visited:
            if can_reach(peer, target, visited.copy(), depth + 1):
                return True
    return False

def validate_path(observed_path, probe_asn, isp_name):
    """
    Validate each transit ASN in the path using multi-level peer checking.
    Returns (verdict, per_asn_results)
    """
    if len(observed_path) <= 1:
        return "no_transit", []

    transit_asns = observed_path[1:-1] if len(observed_path) > 2 else []
    dest_asn = observed_path[-1]

    if not transit_asns:
        # direct: probe → destination
        if can_reach(probe_asn, dest_asn):
            return "consistent_direct", [(dest_asn, "reachable via known peers", True)]
        else:
            return "unverified_direct", [(dest_asn, "not found in peer tables", False)]

    per_asn = []
    all_verified = True
    any_verified = False

    for asn in transit_asns:
        name = ASN_NAMES.get(asn, f"AS{asn} (unknown)")
        # check if reachable from probe through peer chain
        reachable = can_reach(probe_asn, asn)
        per_asn.append((asn, name, reachable))
        if reachable:
            any_verified = True
        else:
            all_verified = False

    if all_verified:
        verdict = "consistent"
    elif any_verified:
        verdict = "partial_verified"
    else:
        verdict = "unverified"

    return verdict, per_asn

def main():
    print("Loading BGP validation results...")
    df = pd.read_csv('findings/bgp_validation_results.csv')

    unique_paths = df[df['observed_path'].notna()]\
        .groupby(['isp', 'target_hostname', 'observed_path'])\
        .size().reset_index(name='count')\
        .sort_values(['isp', 'count'], ascending=[True, False])

    print(f"Validating {len(unique_paths)} unique paths with multi-level peer checking\n")
    print("=" * 70)

    results = []
    anomalies = []

    for _, row in unique_paths.iterrows():
        isp = row['isp']
        site = row['target_hostname']
        path_str = row['observed_path']
        count = row['count']
        path = parse_path(path_str)
        probe_asn = ISP_ASN.get(isp)

        if not probe_asn or not path:
            continue

        verdict, per_asn = validate_path(path, probe_asn, isp)

        # build readable details
        details_parts = []
        for asn, name, verified in per_asn:
            mark = "✅" if verified else "❌"
            details_parts.append(f"AS{asn} {name} {mark}")

        details = " → ".join(details_parts) if details_parts else ""

        print(f"ISP: {isp:<12} Site: {site:<20} Count: {count}")
        print(f"  Path:    {path_str}")
        print(f"  Verdict: {verdict.upper()}")
        if details:
            print(f"  Transit: {details}")
        print()

        if verdict in ('unverified', 'unverified_direct', 'partial_verified'):
            anomalies.append({
                'isp': isp, 'site': site,
                'path': path_str, 'count': count,
                'verdict': verdict, 'details': details
            })

        results.append({
            'isp': isp, 'site': site,
            'observed_path': path_str, 'count': count,
            'verdict': verdict, 'details': details,
        })

    out = pd.DataFrame(results)
    out.to_csv('findings/bgp_rigorous_validation.csv', index=False)

    print("=" * 70)
    print("\n=== Summary ===")
    print(out['verdict'].value_counts())

    print("\n=== Remaining anomalies after multi-level checking ===")
    if anomalies:
        for a in anomalies:
            print(f"  {a['isp']:<12} {a['site']:<20} {a['path']}")
            print(f"    {a['verdict'].upper()}: {a['details']}")
    else:
        print("  None — all paths explained by known peer relationships")

    print("\nSaved to findings/bgp_rigorous_validation.csv")

if __name__ == "__main__":
    main()